{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {"deploymentEnabled": false},
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.giulioni.com"
        }
      ],
      "destination": "https://giulioni.com/$1",
      "permanent": true
    },
    {
      "source": "/career",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/career/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/work/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/media",
      "destination": "/podcast/",
      "permanent": true
    },
    {
      "source": "/media/",
      "destination": "/podcast/",
      "permanent": true
    },
    {
      "source": "/assets/nick-giulioni-resume.pdf",
      "destination": "/about/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/contact/thanks/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/contact/error/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
